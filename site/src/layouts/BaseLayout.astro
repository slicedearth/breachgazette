---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  section?: string;
  robots?: string;
}

const {
  title,
  description,
  section = "The public record",
  robots = "index,follow,max-image-preview:large",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL;
const contentSecurityPolicy = [
  "default-src 'self'",
  "base-uri 'self'",
  "connect-src 'self'",
  "font-src 'self'",
  "form-action 'none'",
  "img-src 'self' data:",
  "manifest-src 'self'",
  "media-src 'self'",
  "object-src 'none'",
  "script-src 'self'",
  "style-src 'self'",
  "worker-src 'none'",
  ...(process.env.BREACHGAZETTE_TEST_BUILD === "1"
    ? []
    : ["upgrade-insecure-requests"]),
].join("; ");
const isCurrent = (path: string) =>
  Astro.url.pathname.startsWith(new URL(`${base}${path}`, Astro.site).pathname);
const isJurisdiction = [
  "jurisdictions/",
  "australia/",
  "united-states/",
  "france/",
  "netherlands/",
  "united-kingdom/",
  "ireland/",
]
  .some((path) => isCurrent(path));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="referrer" content="no-referrer" />
    <meta name="robots" content={robots} />
    <meta
      http-equiv="Content-Security-Policy"
      content={contentSecurityPolicy}
    />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${import.meta.env.BASE_URL}favicon-32.png`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />
    <link rel="alternate" type="application/atom+xml" title="Breach Gazette notifications" href={`${import.meta.env.BASE_URL}feeds/notifications.xml`} />
    <link rel="alternate" type="application/atom+xml" title="Breach Gazette corrections" href={`${import.meta.env.BASE_URL}feeds/corrections.xml`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Breach Gazette" />
    <meta property="og:title" content={`${title} | Breach Gazette`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(`${import.meta.env.BASE_URL}og-card.png`, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title} | Breach Gazette</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="shell masthead">
        <a class="brand" href={import.meta.env.BASE_URL}>
          <img class="brand-mark" src={`${base}gazette-emblem.png`} width="80" height="80" alt="" />
          <span class="brand-copy">
            <span class="brand-title">Breach <span>Gazette</span></span>
            <small>The public record, source by source.</small>
          </span>
        </a>
        <p class="masthead-note"><span>Independent index</span>Breach notifications<br />&amp; the sources behind them</p>
        <button
          class="nav-toggle"
          type="button"
          aria-controls="primary-navigation"
          aria-expanded="false"
          hidden
        >
          <span>Menu</span>
          <span class="nav-toggle__icon" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </span>
        </button>
        <nav id="primary-navigation" aria-label="Primary">
          <a href={`${base}latest/`} aria-current={isCurrent("latest/") ? "page" : undefined}><span class="nav-index" aria-hidden="true">01</span> Notifications</a>
          <a href={`${base}jurisdictions/`} aria-current={isJurisdiction ? "page" : undefined}><span class="nav-index" aria-hidden="true">02</span> Jurisdictions</a>
          <a href={`${base}regulatory-actions/`} aria-current={isCurrent("regulatory-actions/") || isCurrent("matters/") ? "page" : undefined}><span class="nav-index" aria-hidden="true">03</span> Regulatory actions</a>
          <a href={`${base}aggregates/`} aria-current={isCurrent("aggregates/") ? "page" : undefined}><span class="nav-index" aria-hidden="true">04</span> Aggregate metrics</a>
          <a href={`${base}sources/`} aria-current={isCurrent("sources/") || isCurrent("source-coverage/") || isCurrent("source-health/") ? "page" : undefined}><span class="nav-index" aria-hidden="true">05</span> Sources</a>
          <a href={`${base}methodology/`} aria-current={isCurrent("methodology/") ? "page" : undefined}><span class="nav-index" aria-hidden="true">06</span> Methodology</a>
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <div class="shell page-kicker"><span>{section}</span><span class="page-kicker__note" aria-hidden="true">Read the notice. Keep the context.</span></div>
      <slot />
    </main>
    <footer>
      <div class="shell footer-grid">
        <div class="footer-colophon">
          <p class="footer-title"><img src={`${base}gazette-emblem.png`} width="48" height="48" alt="" />Breach Gazette<span aria-hidden="true">.</span></p>
          <p>Official sources, with their limits in view. Breach Gazette does not independently verify the events they report.</p>
        </div>
        <nav aria-label="Footer">
          <a href={`${import.meta.env.BASE_URL}privacy/`}>Privacy</a>
          <a href={`${import.meta.env.BASE_URL}security/`}>Security</a>
          <a href={`${import.meta.env.BASE_URL}data/publication.json`}>Publication identity</a>
          <a href={`${import.meta.env.BASE_URL}legal-and-licensing/`}>Legal and licensing</a>
          <a href={`${import.meta.env.BASE_URL}limitations/`}>Limitations</a>
        </nav>
      </div>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
      const navigation = document.querySelector<HTMLElement>("#primary-navigation");
      const mobileNavigation = window.matchMedia("(max-width: 760px)");

      if (toggle && navigation) {
        const setOpen = (open: boolean) => {
          toggle.setAttribute("aria-expanded", String(open));
          navigation.hidden = mobileNavigation.matches && !open;
        };

        const syncNavigation = () => {
          toggle.hidden = !mobileNavigation.matches;
          setOpen(false);
        };

        toggle.addEventListener("click", () => {
          setOpen(toggle.getAttribute("aria-expanded") !== "true");
        });

        navigation.addEventListener("click", (event) => {
          if (event.target instanceof HTMLAnchorElement && mobileNavigation.matches) {
            setOpen(false);
          }
        });

        document.addEventListener("keydown", (event) => {
          if (
            event.key === "Escape" &&
            mobileNavigation.matches &&
            toggle.getAttribute("aria-expanded") === "true"
          ) {
            setOpen(false);
            toggle.focus();
          }
        });

        mobileNavigation.addEventListener("change", syncNavigation);
        syncNavigation();
      }
    </script>
  </body>
</html>
