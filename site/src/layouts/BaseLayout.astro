---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  section?: string;
}

const { title, description, section = "Observatory" } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="referrer" content="no-referrer" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${import.meta.env.BASE_URL}favicon-32.png`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Breach Gazette" />
    <meta property="og:title" content={`${title} | Breach Gazette`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(`${import.meta.env.BASE_URL}og-card.png`, Astro.site)} />
    <title>{title} | Breach Gazette</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="shell masthead">
        <a class="brand" href={import.meta.env.BASE_URL}>
          <span aria-hidden="true" class="brand-mark">
            <span class="mark-spine"></span>
            <span class="mark-register mark-register-one"></span>
            <span class="mark-register mark-register-two"></span>
            <span class="mark-register mark-register-three"></span>
          </span>
          <span>Breach Gazette<small>Public notification and regulatory record</small></span>
        </a>
        <nav aria-label="Primary">
          <a href={`${import.meta.env.BASE_URL}australia/`}>Australia</a>
          <a href={`${import.meta.env.BASE_URL}united-states/`}>United States</a>
          <a href={`${import.meta.env.BASE_URL}latest/`}>Notifications</a>
          <a href={`${import.meta.env.BASE_URL}sources/`}>Sources</a>
          <a href={`${import.meta.env.BASE_URL}methodology/`}>Methodology</a>
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <div class="shell page-kicker"><span>{section}</span></div>
      <slot />
    </main>
    <footer>
      <div class="shell footer-grid">
        <p>
          Breach Gazette reproduces or derives information from official public sources and
          does not independently verify underlying events.
        </p>
        <nav aria-label="Footer">
          <a href={`${import.meta.env.BASE_URL}privacy/`}>Privacy</a>
          <a href={`${import.meta.env.BASE_URL}security/`}>Security</a>
          <a href={`${import.meta.env.BASE_URL}legal-and-licensing/`}>Legal and licensing</a>
          <a href={`${import.meta.env.BASE_URL}limitations/`}>Limitations</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
