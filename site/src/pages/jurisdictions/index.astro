---
import Hero from "../../components/Hero.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublication } from "../../lib/data";

const publication = getPublication();
const jurisdictions = [
  {
    href: "australia/",
    country: "Australia",
    code: "AU",
    model: "Aggregates, public registers, and legal-status events",
    description: "OAIC national statistics and regulatory actions alongside NSW aggregate and rolling-register publications.",
  },
  {
    href: "united-states/",
    country: "United States",
    code: "US",
    model: "Named state notification records",
    description: "Washington, California, and Massachusetts records with each state's reporting threshold, role, and public window kept separate.",
  },
  {
    href: "france/",
    country: "France",
    code: "FR",
    model: "Anonymized notification summaries",
    description: "CNIL notification-row counts published only as grouped, privacy-minimised metrics without organization inference.",
  },
  {
    href: "united-kingdom/",
    country: "United Kingdom",
    code: "UK",
    model: "Deduplicated anonymized report summaries",
    description: "ICO report-reference counts and source-labelled characteristics, with raw row combinations excluded from publication.",
  },
  {
    href: "netherlands/",
    country: "Netherlands",
    code: "NL",
    model: "Annual national notification aggregates",
    description: "AP annual notification, cyberattack-cause, and account-takeover figures preserved as separate, non-additive dimensions.",
  },
];
---

<BaseLayout title="Jurisdictions" description="Countries and official-source publication models represented by Breach Gazette." section="Coverage">
  <Hero
    eyebrow="Jurisdictions"
    title="Different laws, different evidence"
    intro="Each country view keeps its source threshold, publication unit, time window, and naming practice visible. Counts are not converted into a cross-country ranking."
    warning="A larger count can reflect more notification rows, a different legal threshold, or repeated reports. It does not necessarily mean more unique incidents."
  />
  <section class="section shell">
    <div class="jurisdiction-index">
      {jurisdictions.map((jurisdiction) => (
        <article>
          <span class="jurisdiction-index__code" aria-hidden="true">{jurisdiction.code}</span>
          <div class="jurisdiction-index__title">
            <h2><a href={`${import.meta.env.BASE_URL}${jurisdiction.href}`}>{jurisdiction.country}</a></h2>
            <small>
            {Object.values(publication.policies).filter(
              (policy) => policy.implemented && policy.country === jurisdiction.country,
            ).length.toLocaleString()} supported official sources
            </small>
          </div>
          <div class="jurisdiction-index__description"><h3>{jurisdiction.model}</h3><p>{jurisdiction.description}</p></div>
        </article>
      ))}
    </div>
    <p><a href={`${import.meta.env.BASE_URL}source-coverage/`}>Compare every source window and record unit</a></p>
  </section>
</BaseLayout>
