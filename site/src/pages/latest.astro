---
import Hero from "../components/Hero.astro";
import NotificationTable from "../components/NotificationTable.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublication } from "../lib/data";

const publication = getPublication();
---

<BaseLayout title="Latest public notifications" description="Search official public notification records locally in your browser.">
  <Hero
    eyebrow="Named source records"
    title="Latest public notifications"
    intro="Filter the complete bounded published notification dataset locally. Search terms stay in this browser and are not transmitted."
    warning="A notification is not automatically a unique incident. The source role of the named entity is preserved."
  />
  <section class="section shell">
    <div class="filters" data-notification-filters>
      <label>Organization or agency<input type="search" name="query" autocomplete="off" /></label>
      <label>Jurisdiction<select name="jurisdiction"><option value="">All jurisdictions</option></select></label>
      <label>Regulator<select name="regulator"><option value="">All regulators</option></select></label>
      <label>Source<select name="source"><option value="">All sources</option></select></label>
      <label>Source date<input type="date" name="date" /></label>
      <label>Breach cause<select name="cause"><option value="">All published causes</option></select></label>
      <label>Information category<select name="information"><option value="">All published categories</option></select></label>
      <label>Affected population<select name="population"><option value="">All population bands</option><option value="not_published">Not published</option><option value="500_999">500–999</option><option value="1000_9999">1,000–9,999</option><option value="10000_99999">10,000–99,999</option><option value="100000_plus">100,000+</option></select></label>
      <label>Entity role<select name="role"><option value="">All roles</option></select></label>
      <label>Publication level<select name="publication"><option value="">All publication levels</option></select></label>
    </div>
    <p aria-live="polite" data-result-count>Loading bounded dataset…</p>
    <div data-results>
      <NotificationTable records={publication.latest_notifications} limit={50} />
    </div>
    <noscript><p class="notice">JavaScript is unavailable. The latest 50 records remain visible; use the source pages for static views.</p></noscript>
  </section>
  <script>
    import { label, date } from "../lib/format";
    import type {
      Notification,
      SearchManifest,
      SearchPartition,
      SearchPartitionMetadata,
    } from "../lib/types";

    const base = import.meta.env.BASE_URL;
    const controls = document.querySelector<HTMLElement>("[data-notification-filters]");
    const results = document.querySelector<HTMLElement>("[data-results]");
    const count = document.querySelector<HTMLElement>("[data-result-count]");
    if (controls && results && count) {
      const response = await fetch(`${base}data/notifications/manifest.json`, {
        credentials: "same-origin",
      }).catch(() => null);
      if (!response?.ok) {
        count.textContent = "Search manifest could not be loaded. The latest static records remain available.";
      } else {
      const manifest = (await response.json()) as SearchManifest;
      const jurisdiction = controls.querySelector<HTMLSelectElement>('[name="jurisdiction"]')!;
      const regulator = controls.querySelector<HTMLSelectElement>('[name="regulator"]')!;
      const source = controls.querySelector<HTMLSelectElement>('[name="source"]')!;
      const sourceDate = controls.querySelector<HTMLInputElement>('[name="date"]')!;
      const cause = controls.querySelector<HTMLSelectElement>('[name="cause"]')!;
      const information = controls.querySelector<HTMLSelectElement>('[name="information"]')!;
      const population = controls.querySelector<HTMLSelectElement>('[name="population"]')!;
      const role = controls.querySelector<HTMLSelectElement>('[name="role"]')!;
      const publication = controls.querySelector<HTMLSelectElement>('[name="publication"]')!;
      const query = controls.querySelector<HTMLInputElement>('[name="query"]')!;
      const options = (values: string[]) => [...new Set(values)].sort();
      for (const value of options(manifest.facets.jurisdictions)) jurisdiction.add(new Option(value, value));
      for (const value of options(manifest.facets.regulators)) regulator.add(new Option(value, value));
      for (const value of options(manifest.facets.sources)) source.add(new Option(label(value), value));
      for (const value of options(manifest.facets.causes)) cause.add(new Option(label(value), value));
      for (const value of options(manifest.facets.information_categories)) information.add(new Option(label(value), value));
      for (const value of options(manifest.facets.roles)) role.add(new Option(label(value), value));
      for (const value of options(manifest.facets.publication_levels)) publication.add(new Option(label(value), value));
      const populationBand = (record: Notification) => {
        const affected = record.affected_population?.count;
        if (affected === null || affected === undefined) return "not_published";
        if (affected < 1_000) return "500_999";
        if (affected < 10_000) return "1000_9999";
        if (affected < 100_000) return "10000_99999";
        return "100000_plus";
      };

      const initialResults = results.cloneNode(true) as HTMLElement;
      const initialCount = results.querySelectorAll("tbody tr").length;
      const partitionCache = new Map<string, Promise<Notification[]>>();
      const loadPartition = (partition: SearchPartitionMetadata) => {
        const existing = partitionCache.get(partition.id);
        if (existing) return existing;
        const pending = fetch(
          `${base}data/notifications/${encodeURIComponent(partition.id)}.json`,
          { credentials: "same-origin" },
        ).then(async (partitionResponse) => {
          if (!partitionResponse.ok) throw new Error("Notification search partition is unavailable.");
          const payload = (await partitionResponse.json()) as SearchPartition;
          if (payload.partition_id !== partition.id || !Array.isArray(payload.records)) {
            throw new Error("Notification search partition is invalid.");
          }
          return payload.records;
        });
        partitionCache.set(partition.id, pending);
        return pending;
      };

      const matchesPartition = (partition: SearchPartitionMetadata) =>
        (!jurisdiction.value || partition.jurisdictions.includes(jurisdiction.value)) &&
        (!regulator.value || partition.regulators.includes(regulator.value)) &&
        (!source.value || partition.sources.includes(source.value)) &&
        (!sourceDate.value || partition.years.includes(sourceDate.value.slice(0, 4))) &&
        (!cause.value || partition.causes.includes(cause.value)) &&
        (!information.value || partition.information_categories.includes(information.value)) &&
        (!population.value || partition.population_bands.includes(population.value)) &&
        (!role.value || partition.roles.includes(role.value)) &&
        (!publication.value || partition.publication_levels.includes(publication.value));

      const cell = (tag: "th" | "td", value: string) => {
        const element = document.createElement(tag);
        element.textContent = value;
        return element;
      };
      const renderTable = (records: Notification[]) => {
        const visible = records.slice(0, 50);
        const container = document.createElement("div");
        container.className = "table-wrap";
        container.tabIndex = 0;
        container.setAttribute("aria-label", "Scrollable filtered public notification table");
        const table = document.createElement("table");
        const head = table.createTHead();
        const headingRow = head.insertRow();
        for (const heading of ["Named entity", "Source role", "Jurisdiction", "Source date", "Publication level"]) {
          const header = cell("th", heading);
          header.scope = "col";
          headingRow.append(header);
        }
        const body = table.createTBody();
        for (const record of visible) {
          const row = body.insertRow();
          const entity = cell("th", "");
          entity.scope = "row";
          const observed = record.dates.find((item) => item.normalized_date)?.normalized_date;
          if (record.has_detail_page) {
            const link = document.createElement("a");
            link.href = `${base}notifications/${encodeURIComponent(record.source_record_id)}/`;
            link.textContent = record.named_entity.source_name;
            entity.append(link);
          } else {
            entity.textContent = record.named_entity.source_name;
          }
          row.append(
            entity,
            cell("td", label(record.named_entity.role)),
            cell("td", record.jurisdiction),
            cell("td", date(observed)),
            cell("td", label(record.publication_level)),
          );
        }
        container.append(table);
        results.replaceChildren(container);
      };

      let renderVersion = 0;
      let debounce: number | undefined;
      const render = async () => {
        const version = ++renderVersion;
        const hasFilters = [...controls.querySelectorAll<HTMLInputElement | HTMLSelectElement>("input, select")]
          .some((control) => control.value.trim() !== "");
        if (!hasFilters) {
          results.replaceChildren(...[...initialResults.childNodes].map((node) => node.cloneNode(true)));
          results.removeAttribute("aria-busy");
          count.textContent = `${manifest.record_count.toLocaleString()} matching source records. Showing the latest ${initialCount}; no search partitions loaded.`;
          return;
        }
        const candidatePartitions = manifest.partitions.filter(matchesPartition);
        results.setAttribute("aria-busy", "true");
        count.textContent = `Searching ${candidatePartitions.length.toLocaleString()} relevant data partitions locally…`;
        try {
          const records: Notification[] = [];
          for (let offset = 0; offset < candidatePartitions.length; offset += 4) {
            const batch = candidatePartitions.slice(offset, offset + 4);
            const loaded = await Promise.all(batch.map(loadPartition));
            if (version !== renderVersion) return;
            records.push(...loaded.flat());
            count.textContent = `Searching ${Math.min(offset + batch.length, candidatePartitions.length).toLocaleString()} of ${candidatePartitions.length.toLocaleString()} relevant data partitions locally…`;
          }
          if (version !== renderVersion) return;
          const term = query.value.trim().toLocaleLowerCase();
          const filtered = records.filter((record) =>
            (!term || record.named_entity.source_name.toLocaleLowerCase().includes(term)) &&
            (!jurisdiction.value || record.jurisdiction === jurisdiction.value) &&
            (!regulator.value || record.regulator === regulator.value) &&
            (!source.value || record.source_id === source.value) &&
            (!sourceDate.value || record.dates.some((item) => item.normalized_date === sourceDate.value)) &&
            (!cause.value || record.breach_cause?.normalized_label === cause.value) &&
            (!information.value || record.information_categories.some((item) => item.normalized_label === information.value)) &&
            (!population.value || populationBand(record) === population.value) &&
            (!role.value || record.named_entity.role === role.value) &&
            (!publication.value || record.publication_level === publication.value)
          );
          const visible = filtered.slice(0, 50);
          count.textContent = `${filtered.length.toLocaleString()} matching source records. Showing ${visible.length}; loaded ${candidatePartitions.length.toLocaleString()} of ${manifest.partitions.length.toLocaleString()} partitions.`;
          renderTable(visible);
          results.removeAttribute("aria-busy");
        } catch {
          if (version !== renderVersion) return;
          results.replaceChildren(...[...initialResults.childNodes].map((node) => node.cloneNode(true)));
          results.removeAttribute("aria-busy");
          count.textContent = "Search partitions could not be loaded. The latest static records remain available.";
        }
      };

      controls.addEventListener("input", () => {
        window.clearTimeout(debounce);
        debounce = window.setTimeout(() => void render(), query.value ? 180 : 0);
      });
      void render();
      }
    }
  </script>
</BaseLayout>
