---
import Hero from "../components/Hero.astro";
import NotificationPagination from "../components/NotificationPagination.astro";
import NotificationTable from "../components/NotificationTable.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublication } from "../lib/data";
import { getNotificationPage, NOTIFICATIONS_PER_PAGE } from "../lib/notifications";

const publication = getPublication();
const staticPage = getNotificationPage(publication.latest_notifications, 1);
---

<BaseLayout title="Latest public notifications" description="Search official public notification records locally in your browser.">
  <Hero
    eyebrow="Named source records"
    title="Latest public notifications"
    intro="Filter the complete bounded published notification dataset locally. Search terms stay in this browser and are not transmitted."
    warning="A notification is not automatically a unique incident. The source role of the named entity is preserved."
  />
  <section class="section shell">
    <div class="search-panel">
      <div class="search-panel__heading">
        <div>
          <span class="eyebrow">Local register search</span>
          <h2>Find a published source record</h2>
        </div>
        <p>Filters run in this browser. Pagination changes only the visible results; exports retain every match.</p>
      </div>
      <div class="filters" data-notification-filters>
        <label>Organization or agency<input type="search" name="query" autocomplete="off" maxlength="120" /></label>
        <label>Jurisdiction<select name="jurisdiction"><option value="">All jurisdictions</option></select></label>
        <label>Regulator<select name="regulator"><option value="">All regulators</option></select></label>
        <label>Source<select name="source"><option value="">All sources</option></select></label>
        <label>Source date<input type="date" name="date" /></label>
        <label>Breach cause<select name="cause"><option value="">All published causes</option></select></label>
        <label>Information category<select name="information"><option value="">All published categories</option></select></label>
        <label>Affected population<select name="population"><option value="">All population bands</option><option value="not_published">Not published</option><option value="500_999">500–999</option><option value="1000_9999">1,000–9,999</option><option value="10000_99999">10,000–99,999</option><option value="100000_plus">100,000+</option></select></label>
        <label>Entity role<select name="role"><option value="">All roles</option></select></label>
        <label>Publication level<select name="publication"><option value="">All publication levels</option></select></label>
      </div>
      <div class="result-actions">
        <button type="button" data-export-results disabled>Export matching CSV</button>
        <button type="button" data-copy-search disabled>Copy search link</button>
        <span class="table-note" data-export-status>Apply a filter to enable export.</span>
        <span class="table-note" data-share-status>Search-link filters stay in the URL fragment and are not sent in HTTP requests.</span>
      </div>
    </div>
    <p aria-live="polite" data-result-count>Loading bounded dataset…</p>
    <div data-results>
      <p class="directory-summary">
        Showing the latest {staticPage.firstItem.toLocaleString()}–{staticPage.lastItem.toLocaleString()} of{" "}
        {staticPage.total.toLocaleString()} statically published records.
      </p>
      <NotificationPagination
        currentPage={staticPage.currentPage}
        pageCount={staticPage.pageCount}
        position="top"
      />
      <NotificationTable
        records={staticPage.items}
        limit={NOTIFICATIONS_PER_PAGE}
        showSummary={false}
      />
      <NotificationPagination
        currentPage={staticPage.currentPage}
        pageCount={staticPage.pageCount}
        position="bottom"
      />
    </div>
    <noscript><p class="notice">JavaScript is unavailable. Use the static page links to review the latest published records in groups of 50.</p></noscript>
  </section>
  <script>
    import { label, date } from "../lib/format";
    import {
      getNotificationPaginationItems,
      NOTIFICATIONS_PER_PAGE,
    } from "../lib/notifications";
    import type {
      Notification,
      SearchManifest,
      SearchPartition,
      SearchPartitionMetadata,
    } from "../lib/types";

    const base = import.meta.env.BASE_URL;
    const controls = document.querySelector<HTMLElement>("[data-notification-filters]");
    const results = document.querySelector<HTMLElement>("[data-results]");
    const count = document.querySelector<HTMLElement>("[data-result-count]");
    if (controls && results && count) {
      const response = await fetch(`${base}data/notifications/manifest.json`, {
        credentials: "same-origin",
      }).catch(() => null);
      if (!response?.ok) {
        count.textContent = "Search manifest could not be loaded. The latest static records remain available.";
      } else {
      const manifest = (await response.json()) as SearchManifest;
      const jurisdiction = controls.querySelector<HTMLSelectElement>('[name="jurisdiction"]')!;
      const regulator = controls.querySelector<HTMLSelectElement>('[name="regulator"]')!;
      const source = controls.querySelector<HTMLSelectElement>('[name="source"]')!;
      const sourceDate = controls.querySelector<HTMLInputElement>('[name="date"]')!;
      const cause = controls.querySelector<HTMLSelectElement>('[name="cause"]')!;
      const information = controls.querySelector<HTMLSelectElement>('[name="information"]')!;
      const population = controls.querySelector<HTMLSelectElement>('[name="population"]')!;
      const role = controls.querySelector<HTMLSelectElement>('[name="role"]')!;
      const publication = controls.querySelector<HTMLSelectElement>('[name="publication"]')!;
      const query = controls.querySelector<HTMLInputElement>('[name="query"]')!;
      const exportButton = document.querySelector<HTMLButtonElement>("[data-export-results]")!;
      const exportStatus = document.querySelector<HTMLElement>("[data-export-status]")!;
      const copySearchButton = document.querySelector<HTMLButtonElement>("[data-copy-search]")!;
      const shareStatus = document.querySelector<HTMLElement>("[data-share-status]")!;
      const options = (values: string[]) => [...new Set(values)].sort();
      for (const value of options(manifest.facets.jurisdictions)) jurisdiction.add(new Option(value, value));
      for (const value of options(manifest.facets.regulators)) regulator.add(new Option(value, value));
      for (const value of options(manifest.facets.sources)) source.add(new Option(label(value), value));
      for (const value of options(manifest.facets.causes)) cause.add(new Option(label(value), value));
      for (const value of options(manifest.facets.information_categories)) information.add(new Option(label(value), value));
      for (const value of options(manifest.facets.roles)) role.add(new Option(label(value), value));
      for (const value of options(manifest.facets.publication_levels)) publication.add(new Option(label(value), value));
      const filterControls = [
        ...controls.querySelectorAll<HTMLInputElement | HTMLSelectElement>("input, select"),
      ];
      let currentPage = 1;
      const hasFilters = () =>
        filterControls.some((control) => control.value.trim() !== "");
      const applyHashState = () => {
        const parameters = new URLSearchParams(
          window.location.hash.startsWith("#") ? window.location.hash.slice(1) : "",
        );
        for (const control of filterControls) {
          const value = (parameters.get(control.name) ?? "").slice(0, 120);
          if (
            control instanceof HTMLSelectElement &&
            value &&
            ![...control.options].some((option) => option.value === value)
          ) {
            control.value = "";
          } else {
            control.value = value;
          }
        }
        const requestedPage = Number.parseInt(parameters.get("page") ?? "1", 10);
        currentPage = Number.isFinite(requestedPage) && requestedPage > 0
          ? requestedPage
          : 1;
      };
      const syncHashState = (mode: "push" | "replace" = "replace") => {
        const parameters = new URLSearchParams();
        for (const control of filterControls) {
          const value = control.value.trim();
          if (value) parameters.set(control.name, value);
        }
        if (hasFilters() && currentPage > 1) parameters.set("page", String(currentPage));
        const fragment = parameters.toString();
        const nextUrl =
          `${window.location.pathname}${window.location.search}${fragment ? `#${fragment}` : ""}`;
        if (mode === "push") window.history.pushState(null, "", nextUrl);
        else window.history.replaceState(null, "", nextUrl);
        copySearchButton.disabled = !hasFilters();
        shareStatus.textContent = fragment
          ? "This search can be bookmarked without sending its filters in HTTP requests."
          : "Search-link filters stay in the URL fragment and are not sent in HTTP requests.";
      };
      const populationBand = (record: Notification) => {
        const affected = record.affected_population?.count;
        if (affected === null || affected === undefined) return "not_published";
        if (affected < 1_000) return "500_999";
        if (affected < 10_000) return "1000_9999";
        if (affected < 100_000) return "10000_99999";
        return "100000_plus";
      };

      const initialResults = results.cloneNode(true) as HTMLElement;
      const initialCount = results.querySelectorAll("tbody tr").length;
      const partitionCache = new Map<string, Promise<Notification[]>>();
      let filteredRecords: Notification[] = [];
      let loadedPartitionCount = 0;
      const loadPartition = (partition: SearchPartitionMetadata) => {
        const existing = partitionCache.get(partition.id);
        if (existing) return existing;
        const pending = fetch(
          `${base}data/notifications/${encodeURIComponent(partition.id)}.json`,
          { credentials: "same-origin" },
        ).then(async (partitionResponse) => {
          if (!partitionResponse.ok) throw new Error("Notification search partition is unavailable.");
          const payload = (await partitionResponse.json()) as SearchPartition;
          if (payload.partition_id !== partition.id || !Array.isArray(payload.records)) {
            throw new Error("Notification search partition is invalid.");
          }
          return payload.records;
        });
        partitionCache.set(partition.id, pending);
        return pending;
      };

      const normalizeSearch = (value: string) =>
        value.toLocaleLowerCase().split(/\s+/).filter(Boolean).join(" ");
      const searchText = (record: Notification) =>
        normalizeSearch([
          record.named_entity.source_name,
          record.source_record_id,
          record.jurisdiction,
          record.regulator,
          record.reporting_scheme,
          record.named_entity.role,
        ].filter(Boolean).join(" "));
      const trigrams = (value: string) => {
        const normalized = normalizeSearch(value);
        const grams = new Set<string>();
        for (let index = 0; index <= normalized.length - 3; index += 1) {
          grams.add(normalized.slice(index, index + 3));
        }
        return grams;
      };
      const fnv1a = (value: string) => {
        let hash = 2_166_136_261;
        for (const byte of new TextEncoder().encode(value)) {
          hash ^= byte;
          hash = Math.imul(hash, 16_777_619) >>> 0;
        }
        return hash;
      };
      const queryMayMatch = (partition: SearchPartitionMetadata, term: string) => {
        if (
          term.length < manifest.query_routing.minimum_query_length ||
          !partition.query_bloom
        ) return true;
        const bloom = Uint8Array.from(
          partition.query_bloom.match(/.{2}/g) ?? [],
          (pair) => Number.parseInt(pair, 16),
        );
        for (const gram of trigrams(term)) {
          for (let seed = 0; seed < manifest.query_routing.hashes; seed += 1) {
            const bit = fnv1a(`${seed}|${gram}`) % manifest.query_routing.bits;
            if ((bloom[Math.floor(bit / 8)]! & (1 << (bit % 8))) === 0) return false;
          }
        }
        return true;
      };

      const matchesPartition = (partition: SearchPartitionMetadata) =>
        (!jurisdiction.value || partition.jurisdictions.includes(jurisdiction.value)) &&
        (!regulator.value || partition.regulators.includes(regulator.value)) &&
        (!source.value || partition.sources.includes(source.value)) &&
        (!sourceDate.value || partition.years.includes(sourceDate.value.slice(0, 4))) &&
        (!cause.value || partition.causes.includes(cause.value)) &&
        (!information.value || partition.information_categories.includes(information.value)) &&
        (!population.value || partition.population_bands.includes(population.value)) &&
        (!role.value || partition.roles.includes(role.value)) &&
        (!publication.value || partition.publication_levels.includes(publication.value)) &&
        queryMayMatch(partition, normalizeSearch(query.value));

      const cell = (tag: "th" | "td", value: string) => {
        const element = document.createElement(tag);
        element.textContent = value;
        return element;
      };
      const renderTable = (records: Notification[]) => {
        const container = document.createElement("div");
        container.className = "table-wrap";
        container.tabIndex = 0;
        container.setAttribute("aria-label", "Scrollable filtered public notification table");
        const table = document.createElement("table");
        table.className = "notification-table";
        const head = table.createTHead();
        const headingRow = head.insertRow();
        for (const heading of ["Named entity", "Source role", "Jurisdiction", "Source date", "Publication level"]) {
          const header = cell("th", heading);
          header.scope = "col";
          headingRow.append(header);
        }
        const body = table.createTBody();
        for (const record of records) {
          const row = body.insertRow();
          const entity = cell("th", "");
          entity.scope = "row";
          entity.className = "notification-table__entity";
          const observed = record.dates.find((item) => item.normalized_date)?.normalized_date;
          if (record.has_detail_page) {
            const link = document.createElement("a");
            link.href = `${base}notifications/${encodeURIComponent(record.source_record_id)}/`;
            link.textContent = record.named_entity.source_name;
            entity.append(link);
          } else {
            entity.textContent = record.named_entity.source_name;
          }
          row.append(
            entity,
            cell("td", label(record.named_entity.role)),
            cell("td", record.jurisdiction),
            cell("td", date(observed)),
            cell("td", label(record.publication_level)),
          );
        }
        container.append(table);
        return container;
      };
      const filterPageHref = (page: number) => {
        const parameters = new URLSearchParams();
        for (const control of filterControls) {
          const value = control.value.trim();
          if (value) parameters.set(control.name, value);
        }
        if (page > 1) parameters.set("page", String(page));
        return `${window.location.pathname}${window.location.search}#${parameters.toString()}`;
      };
      const createPaginationStep = (
        page: number | null,
        direction: "Previous" | "Next",
      ) => {
        const step = document.createElement(page === null ? "span" : "a");
        step.className = "pagination__step";
        if (page === null) {
          step.setAttribute("aria-disabled", "true");
        } else {
          const link = step as HTMLAnchorElement;
          link.href = filterPageHref(page);
          link.dataset.filterPage = String(page);
          link.rel = direction === "Previous" ? "prev" : "next";
        }
        const arrow = document.createElement("span");
        arrow.setAttribute("aria-hidden", "true");
        arrow.textContent = direction === "Previous" ? "←" : "→";
        const text = document.createElement("span");
        text.className = "pagination__step-label";
        text.textContent = direction;
        if (direction === "Previous") step.append(arrow, text);
        else step.append(text, arrow);
        return step;
      };
      const renderPagination = (
        position: "top" | "bottom",
        pageCount: number,
      ) => {
        const navigation = document.createElement("nav");
        navigation.className = `pagination pagination--${position}`;
        navigation.setAttribute(
          "aria-label",
          position === "top"
            ? "Filtered notification pages above results"
            : "Filtered notification pages below results",
        );
        if (position === "top") navigation.id = "notification-results";
        const previous = createPaginationStep(
          currentPage > 1 ? currentPage - 1 : null,
          "Previous",
        );
        const pages = document.createElement("ol");
        pages.className = "pagination__pages";
        for (const page of getNotificationPaginationItems(currentPage, pageCount)) {
          const item = document.createElement("li");
          if (page === null) {
            item.className = "pagination__ellipsis";
            item.setAttribute("aria-hidden", "true");
            item.textContent = "…";
          } else if (page === currentPage) {
            item.className = "is-current";
            const current = document.createElement("span");
            current.setAttribute("aria-current", "page");
            const hidden = document.createElement("span");
            hidden.className = "visually-hidden";
            hidden.textContent = "Page ";
            current.append(hidden, document.createTextNode(String(page)));
            item.append(current);
          } else {
            const link = document.createElement("a");
            link.href = filterPageHref(page);
            link.dataset.filterPage = String(page);
            link.setAttribute("aria-label", `Go to filtered notification page ${page}`);
            link.textContent = String(page);
            item.append(link);
          }
          pages.append(item);
        }
        const next = createPaginationStep(
          currentPage < pageCount ? currentPage + 1 : null,
          "Next",
        );
        navigation.append(previous, pages, next);
        return navigation;
      };
      const renderFilteredPage = () => {
        const pageCount = Math.max(
          1,
          Math.ceil(filteredRecords.length / NOTIFICATIONS_PER_PAGE),
        );
        currentPage = Math.min(Math.max(1, currentPage), pageCount);
        if (!filteredRecords.length) {
          const empty = document.createElement("p");
          empty.className = "notice";
          empty.textContent = "No published source records match these filters.";
          results.replaceChildren(empty);
          count.textContent =
            `0 matching source records across the complete bounded dataset; ` +
            `loaded ${loadedPartitionCount.toLocaleString()} of ${manifest.partitions.length.toLocaleString()} partitions.`;
          return;
        }
        const offset = (currentPage - 1) * NOTIFICATIONS_PER_PAGE;
        const visible = filteredRecords.slice(offset, offset + NOTIFICATIONS_PER_PAGE);
        const first = offset + 1;
        const last = offset + visible.length;
        const summary = document.createElement("p");
        summary.className = "directory-summary";
        summary.textContent =
          `Showing records ${first.toLocaleString()}–${last.toLocaleString()} of ` +
          `${filteredRecords.length.toLocaleString()} matches.`;
        results.replaceChildren(
          summary,
          renderPagination("top", pageCount),
          renderTable(visible),
          renderPagination("bottom", pageCount),
        );
        count.textContent =
          `${filteredRecords.length.toLocaleString()} matching source records across the complete bounded dataset. ` +
          `Showing ${first.toLocaleString()}–${last.toLocaleString()} on filtered page ` +
          `${currentPage.toLocaleString()} of ${pageCount.toLocaleString()}; loaded ` +
          `${loadedPartitionCount.toLocaleString()} of ${manifest.partitions.length.toLocaleString()} partitions.`;
      };

      const csvCell = (value: string | number | null | undefined) => {
        let text = String(value ?? "");
        if (/^[=+\-@]/.test(text)) text = `'${text}`;
        return `"${text.replaceAll('"', '""')}"`;
      };
      const exportCsv = () => {
        if (!filteredRecords.length) return;
        const headers = [
          "source_id",
          "source_record_id",
          "named_entity",
          "source_role",
          "jurisdiction",
          "regulator",
          "reporting_scheme",
          "source_dates",
          "publication_level",
          "affected_population",
          "information_categories",
          "breach_cause",
          "source_url",
        ];
        const rows = filteredRecords.map((record) => [
          record.source_id,
          record.source_record_id,
          record.named_entity.source_name,
          record.named_entity.role,
          record.jurisdiction,
          record.regulator,
          record.reporting_scheme,
          record.dates
            .map((item) => item.normalized_date)
            .filter((value): value is string => Boolean(value))
            .join("; "),
          record.publication_level,
          record.affected_population?.count,
          record.information_categories.map((item) => item.normalized_label).join("; "),
          record.breach_cause?.normalized_label,
          record.source_url,
        ]);
        const csv = [
          headers.map(csvCell).join(","),
          ...rows.map((row) => row.map(csvCell).join(",")),
        ].join("\r\n");
        const url = URL.createObjectURL(new Blob([csv], { type: "text/csv;charset=utf-8" }));
        const link = document.createElement("a");
        link.href = url;
        link.download = "breach-gazette-notifications.csv";
        link.click();
        URL.revokeObjectURL(url);
        exportStatus.textContent = `Exported ${filteredRecords.length.toLocaleString()} matching source records.`;
      };
      exportButton.addEventListener("click", exportCsv);
      copySearchButton.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          shareStatus.textContent = "Search link copied.";
        } catch {
          shareStatus.textContent = "Copy the current address to share this local search state.";
        }
      });

      let renderVersion = 0;
      let debounce: number | undefined;
      const render = async () => {
        const version = ++renderVersion;
        if (!hasFilters()) {
          currentPage = 1;
          filteredRecords = [];
          loadedPartitionCount = 0;
          exportButton.disabled = true;
          exportStatus.textContent = "Apply a filter to enable export.";
          results.replaceChildren(...[...initialResults.childNodes].map((node) => node.cloneNode(true)));
          results.removeAttribute("aria-busy");
          count.textContent = `${manifest.record_count.toLocaleString()} matching source records. Showing the latest ${initialCount}; no search partitions loaded.`;
          return;
        }
        const candidatePartitions = manifest.partitions.filter(matchesPartition);
        results.setAttribute("aria-busy", "true");
        count.textContent = `Searching ${candidatePartitions.length.toLocaleString()} relevant data partitions locally…`;
        try {
          const records: Notification[] = [];
          for (let offset = 0; offset < candidatePartitions.length; offset += 4) {
            const batch = candidatePartitions.slice(offset, offset + 4);
            const loaded = await Promise.all(batch.map(loadPartition));
            if (version !== renderVersion) return;
            records.push(...loaded.flat());
            count.textContent = `Searching ${Math.min(offset + batch.length, candidatePartitions.length).toLocaleString()} of ${candidatePartitions.length.toLocaleString()} relevant data partitions locally…`;
          }
          if (version !== renderVersion) return;
          const term = normalizeSearch(query.value);
          const filtered = records.filter((record) =>
            (!term || searchText(record).includes(term)) &&
            (!jurisdiction.value || record.jurisdiction === jurisdiction.value) &&
            (!regulator.value || record.regulator === regulator.value) &&
            (!source.value || record.source_id === source.value) &&
            (!sourceDate.value || record.dates.some((item) => item.normalized_date === sourceDate.value)) &&
            (!cause.value || record.breach_cause?.normalized_label === cause.value) &&
            (!information.value || record.information_categories.some((item) => item.normalized_label === information.value)) &&
            (!population.value || populationBand(record) === population.value) &&
            (!role.value || record.named_entity.role === role.value) &&
            (!publication.value || record.publication_level === publication.value)
          );
          filteredRecords = filtered;
          loadedPartitionCount = candidatePartitions.length;
          exportButton.disabled = filtered.length === 0;
          exportStatus.textContent = filtered.length
            ? `Ready to export all ${filtered.length.toLocaleString()} matches.`
            : "No matching records to export.";
          renderFilteredPage();
          syncHashState();
          results.removeAttribute("aria-busy");
        } catch {
          if (version !== renderVersion) return;
          results.replaceChildren(...[...initialResults.childNodes].map((node) => node.cloneNode(true)));
          results.removeAttribute("aria-busy");
          filteredRecords = [];
          loadedPartitionCount = 0;
          exportButton.disabled = true;
          exportStatus.textContent = "Export is unavailable while search data is unavailable.";
          count.textContent = "Search partitions could not be loaded. The latest static records remain available.";
        }
      };

      controls.addEventListener("input", () => {
        currentPage = 1;
        syncHashState();
        window.clearTimeout(debounce);
        debounce = window.setTimeout(() => void render(), query.value ? 180 : 0);
      });
      results.addEventListener("click", (event) => {
        if (!(event.target instanceof Element)) return;
        const link = event.target.closest<HTMLAnchorElement>("a[data-filter-page]");
        if (!link || !results.contains(link)) return;
        event.preventDefault();
        const page = Number.parseInt(link.dataset.filterPage ?? "1", 10);
        if (!Number.isFinite(page) || page < 1) return;
        currentPage = page;
        syncHashState("push");
        renderFilteredPage();
        document.querySelector<HTMLElement>("[data-result-count]")?.scrollIntoView({
          block: "start",
        });
      });
      window.addEventListener("hashchange", () => {
        applyHashState();
        syncHashState();
        void render();
      });
      applyHashState();
      syncHashState();
      void render();
      }
    }
  </script>
</BaseLayout>
