---
import Hero from "../../components/Hero.astro";
import RelationshipDirectory from "../../components/RelationshipDirectory.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublication } from "../../lib/data";
import { getRelationshipPage } from "../../lib/relationships";

const publication = getPublication();
const page = getRelationshipPage(publication.relationships, 1);
---

<BaseLayout title="Candidate relationships" description="Evidence-backed candidate relationships between source records.">
  <Hero
    eyebrow="Conservative cross-source links"
    title="Candidate record relationships"
    intro="These records may relate based on the displayed evidence. Breach Gazette does not declare that candidate records describe the same breach."
  />
  <section class="section shell">
    <RelationshipDirectory page={page} />
  </section>
</BaseLayout>
