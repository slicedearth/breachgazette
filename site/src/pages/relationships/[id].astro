---
import DefinitionGrid from "../../components/DefinitionGrid.astro";
import Hero from "../../components/Hero.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublication } from "../../lib/data";
import { label } from "../../lib/format";

export function getStaticPaths() {
  return getPublication().relationships.map((relationship) => ({
    params: { id: relationship.candidate_id },
    props: { relationship },
  }));
}
const { relationship } = Astro.props;
---

<BaseLayout title={relationship.candidate_id} description={relationship.limitations[0] ?? "Candidate relationship between source records."} section="Candidate incident group">
  <Hero
    eyebrow={label(relationship.relationship_class)}
    title="Candidate record relationship"
    intro="These records may relate based on the displayed evidence."
    warning="This is not a declaration that the records describe the same breach. It does not merge their provenance, roles, dates, thresholds, or legal meaning."
  />
  <section class="section shell">
    <DefinitionGrid items={[
      { term: "Candidate ID", description: relationship.candidate_id },
      { term: "Source records", description: relationship.record_ids.join(" and ") },
      { term: "Relationship class", description: label(relationship.relationship_class) },
      { term: "Review state", description: relationship.reviewed ? "Reviewed" : "Not reviewed" },
    ]} />
    <div class="prose">
      <h2>Displayed evidence</h2>
      <ul>{relationship.reasons.map((reason) => <li><strong>{label(reason.code)}:</strong> {reason.explanation} Evidence: {reason.evidence.join("; ")}.</li>)}</ul>
      {relationship.limitations.map((limitation) => <p>{limitation}</p>)}
    </div>
  </section>
</BaseLayout>
