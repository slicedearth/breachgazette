---
import Hero from "../components/Hero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublication } from "../lib/data";
import { date, label } from "../lib/format";

const publication = getPublication();
const sources = publication.source_health.sources;
const sourceName = (sourceId: string) =>
  publication.policies[sourceId]?.name ?? label(sourceId);
const collectionMode = publication.source_health.collection_mode ?? "manual";
const snapshots = new Map(
  publication.manifest.source_snapshots.map((snapshot) => [snapshot.source_id, snapshot]),
);
const healthHistory = publication.source_health_history.snapshots;
---

<BaseLayout title="Source health" description="Freshness and update state for each implemented official source.">
  <Hero
    eyebrow="Automated retrieval health"
    title="Source health"
    intro="Each status reflects bounded retrieval freshness, contract validation, record-count guards, and the latest update checkpoint."
    warning="Healthy means the pipeline completed its checks. It does not establish that an official source is factually complete."
  />
  <section class="section shell">
    <p><a href={`${import.meta.env.BASE_URL}source-coverage/`}>Review source windows and comparison boundaries</a></p>
    <p class="notice">
      {sources.filter((source) => source.status === "healthy").length} of {sources.length} implemented sources are healthy.
      Collection mode is <strong>{collectionMode}</strong>.
      {collectionMode === "scheduled"
        ? <> The active schedule is <code>{publication.source_health.schedule_utc}</code> in UTC.</>
        : <> The reviewed schedule <code>{publication.source_health.schedule_utc}</code> is not active.</>}
    </p>
    <div class="table-wrap" tabindex="0" aria-label="Source health table">
      <table>
        <thead><tr><th scope="col">Source</th><th scope="col">Status</th><th scope="col">Records</th><th scope="col">Snapshot age</th><th scope="col">Freshness limit</th><th scope="col">Last successful update</th></tr></thead>
        <tbody>
          {sources.map((source) => (
            <tr>
              <th scope="row" data-label="Source">
                <a href={`${import.meta.env.BASE_URL}sources/${source.source_id}/`}>
                  {sourceName(source.source_id)}
                </a>
              </th>
              <td data-label="Status"><span class="pill">{label(source.status)}</span></td>
              <td data-label="Records">{source.record_count.toLocaleString()}</td>
              <td data-label="Snapshot age">{source.snapshot_age_hours === null ? "Not available" : `${source.snapshot_age_hours.toLocaleString()} hours`}</td>
              <td data-label="Freshness limit">{source.stale_after_hours.toLocaleString()} hours</td>
              <td data-label="Last successful update">{date(source.last_successful_update)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="section-head">
      <h2>Bounded source-health history</h2>
      <p>
        Showing {healthHistory.length.toLocaleString()} of at most{" "}
        {publication.source_health_history.maximum_snapshots.toLocaleString()} sanitized
        snapshots. Private checksums and diagnostic reasons are excluded.
      </p>
    </div>
    <div class="table-wrap" tabindex="0" aria-label="Bounded source health history table">
      <table>
        <thead>
          <tr>
            <th scope="col">Observed</th>
            <th scope="col">Overall gate</th>
            <th scope="col">Healthy sources</th>
            <th scope="col">Sources needing attention</th>
            <th scope="col">Recovered since prior snapshot</th>
          </tr>
        </thead>
        <tbody>
          {healthHistory.map((snapshot) => {
            const healthy = snapshot.sources.filter((source) => source.status === "healthy");
            const attention = snapshot.sources.filter((source) => source.status !== "healthy");
            return (
              <tr>
                <th scope="row" data-label="Observed">{date(snapshot.generated_at)}</th>
                <td data-label="Overall gate">
                  <span class="pill">{snapshot.passed ? "Passed" : "Needs attention"}</span>
                </td>
                <td data-label="Healthy sources">{healthy.length.toLocaleString()}</td>
                <td data-label="Sources needing attention">
                  {attention.length
                    ? attention.map((source) => sourceName(source.source_id)).join(", ")
                    : "None"}
                </td>
                <td data-label="Recovered since prior snapshot">
                  {snapshot.recoveries_from_previous.length
                    ? snapshot.recoveries_from_previous.map(sourceName).join(", ")
                    : "None observed"}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
    <ul class="table-note">
      {publication.source_health_history.limitations.map((limitation) => (
        <li>{limitation}</li>
      ))}
    </ul>
    <div class="section-head">
      <h2>Publication evidence</h2>
      <p>Revision, acceptance, and checkpoint values come from the complete source snapshot used by this publication.</p>
    </div>
    <div class="grid source-evidence-grid">
      {sources.map((source) => {
        const snapshot = snapshots.get(source.source_id);
        return (
          <article class="card source-evidence-card">
            <h3>
              <a href={`${import.meta.env.BASE_URL}sources/${source.source_id}/`}>
                {sourceName(source.source_id)}
              </a>
            </h3>
            <dl>
              <div><dt>Completeness</dt><dd>{label(source.completeness ?? "not published")}</dd></div>
              <div><dt>Checkpoint</dt><dd>{label(source.checkpoint_status)}</dd></div>
              <div><dt>Reviewed floor</dt><dd>{source.minimum_records.toLocaleString()} records</dd></div>
              <div><dt>Accepted</dt><dd>{snapshot?.records_accepted.toLocaleString() ?? "Not published"}</dd></div>
              <div><dt>Rejected</dt><dd>{snapshot?.records_rejected.toLocaleString() ?? "Not published"}</dd></div>
              <div><dt>Bounded limit</dt><dd>{snapshot?.bounded_limit.toLocaleString() ?? "Not published"}</dd></div>
              <div><dt>Revision</dt><dd><code>{snapshot?.revision ?? "Not published"}</code></dd></div>
              <div><dt>Snapshot checksum</dt><dd><code>{source.snapshot_checksum ?? "Not published"}</code></dd></div>
              <div><dt>Latest attempt</dt><dd>{date(source.latest_attempted_update)}</dd></div>
            </dl>
          </article>
        );
      })}
    </div>
  </section>
</BaseLayout>
