---
import Hero from "../components/Hero.astro";
import NotificationTable from "../components/NotificationTable.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getAllNotifications, getPublication } from "../lib/data";
import { compactNumber, date } from "../lib/format";

const publication = getPublication();
const notifications = getAllNotifications();
const publicationChecksum = publication.manifest.publication_checksum;
const metrics = [
  ["Public notifications", publication.stats.public_notifications ?? 0],
  ["Anonymous notification rows", publication.stats.anonymized_notification_rows ?? 0],
  ["Aggregate metrics", publication.stats.aggregate_metrics ?? 0],
  ["Regulatory actions", publication.stats.regulatory_actions ?? 0],
  ["Healthy sources", publication.source_health.sources.filter((source) => source.status === "healthy").length],
];
---

<BaseLayout title="Overview" description={publication.tagline}>
  <Hero
    eyebrow="Official public-source intelligence"
    title="Public breach notifications, connected and explained."
    intro="Breach Gazette separates aggregate reporting, anonymized notification rows, named public notifications, and legal-status events so each record keeps the meaning, threshold, role, and limitations of its official source."
  />
  <aside class="publication-stamp shell" aria-label="Current publication">
    <div>
      <span class="eyebrow">Current publication</span>
      <strong>Verified {date(publication.generated_at)}</strong>
    </div>
    <p>
      Publication checksum
      <code title={publicationChecksum}>{publicationChecksum.slice(0, 12)}</code>
    </p>
    <a href={`${import.meta.env.BASE_URL}source-health/`}>Review source health</a>
  </aside>
  <section class="section shell" aria-labelledby="at-a-glance">
    <div class="section-head">
      <h2 id="at-a-glance">At a glance</h2>
      <p>Counts describe published source records, not unique real-world incidents.</p>
    </div>
    <div class="grid">
      {metrics.map(([name, value]) => (
        <article class="card">
          <div class="metric">{compactNumber(Number(value))}</div>
          <h3>{name === "Healthy sources" ? <a href={`${import.meta.env.BASE_URL}source-health/`}>{name}</a> : name}</h3>
        </article>
      ))}
    </div>
  </section>
  <section class="section shell" aria-labelledby="four-views">
    <div class="section-head">
      <h2 id="four-views">Four evidence layers</h2>
      <p>Deliberately separate views prevent source statistics from becoming accusations.</p>
    </div>
    <div class="grid">
      <article class="card">
        <span class="pill">Aggregate</span>
        <h3>Reporting patterns</h3>
        <p>The OAIC received these numbers of notifications. The statistics name no organization and never become incident records.</p>
        <a href={`${import.meta.env.BASE_URL}australia/`}>Explore Australian statistics</a>
      </article>
      <article class="card">
        <span class="pill">Anonymous</span>
        <h3>Notification-row patterns</h3>
        <p>French and UK regulators publish report-level facts without organization names. Breach Gazette exposes grouped counts only and never sends those rows into entity resolution.</p>
        <a href={`${import.meta.env.BASE_URL}jurisdictions/`}>Explore anonymized notification patterns</a>
      </article>
      <article class="card">
        <span class="pill">Notification</span>
        <h3>Public register records</h3>
        <p>The notifying entity or agency is shown in its source-defined role. That role may differ from the affected entity.</p>
        <a href={`${import.meta.env.BASE_URL}latest/`}>Review public notifications</a>
      </article>
      <article class="card">
        <span class="pill">Legal status</span>
        <h3>Regulatory timeline</h3>
        <p>Inquiries, investigations, allegations, orders, and findings retain exact status. A filing is never rendered as a finding.</p>
        <a href={`${import.meta.env.BASE_URL}australia/regulatory-actions/`}>Review OAIC actions</a>
      </article>
    </div>
  </section>
  <section class="section shell" aria-labelledby="latest">
    <div class="section-head">
      <h2 id="latest">Latest public notifications</h2>
      <a href={`${import.meta.env.BASE_URL}latest/`}>Search all published records</a>
    </div>
    <NotificationTable records={notifications} limit={12} />
  </section>
</BaseLayout>
