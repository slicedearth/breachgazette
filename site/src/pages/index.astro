---
import NotificationTable from "../components/NotificationTable.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getSourceRevision } from "../lib/build";
import { getAllNotifications, getPublication } from "../lib/data";
import { compactNumber, date } from "../lib/format";

const publication = getPublication();
const notifications = getAllNotifications();
const checksum = publication.manifest.publication_checksum;
const sourceRevision = getSourceRevision();
const base = import.meta.env.BASE_URL;
const metrics = [
  ["Public notifications", publication.stats.public_notifications ?? 0, "latest/"],
  ["Anonymous notification rows", publication.stats.anonymized_notification_rows ?? 0, "jurisdictions/"],
  ["Aggregate metrics", publication.stats.aggregate_metrics ?? 0, "australia/"],
  ["Regulatory actions", publication.stats.regulatory_actions ?? 0, "australia/regulatory-actions/"],
] as const;
const changes = [
  ["First observed", publication.update_digest.counts.records_first_observed, "Not present in the previous comparable snapshot."],
  ["Corrected", publication.update_digest.counts.records_corrected, "Source-backed fields have changed."],
  ["Absent from a complete snapshot", publication.update_digest.counts.records_absent_from_complete_snapshot, "No longer listed. This is not evidence of remediation."],
  ["Sources recovered", publication.update_digest.counts.sources_recovered, "Collection passed after an earlier recorded problem."],
] as const;
---

<BaseLayout title="The public record" description="Search official breach notifications, compare reporting rules and follow regulator actions. Every record keeps its source and its limits." section="Front page">
  <header class="front-page shell">
    <div class="front-page__lead">
      <p class="eyebrow front-page__overline"><span>Official notices</span><span>Open to scrutiny</span></p>
      <h1>When a breach<br /> becomes <em>public.</em></h1>
      <p class="lede">Official notices are scattered across registers, reports and regulator websites. Read them here, with the source attached and the differences kept in view.</p>
      <div class="front-page__actions">
        <a class="action-link" href={`${base}latest/`}>Search the notifications <span aria-hidden="true">↗</span></a>
        <a href={`${base}methodology/`}>How to read the record</a>
      </div>
    </div>
    <figure class="front-page__illustration">
      <img src={`${base}notice-carrier.png`} width="640" height="640" alt="" fetchpriority="high" />
      <figcaption><span aria-hidden="true">↳</span> Every entry starts with a source.<br /><a href={`${base}sources/`}>Meet the sources</a></figcaption>
    </figure>
  </header>
    <aside class="edition-index shell" aria-labelledby="edition-index-title">
      <div class="edition-index__heading"><h2 id="edition-index-title">Four kinds of record.</h2><span>A register, not a ranking.</span></div>
      <dl>
        {metrics.map(([name, value, href], index) => (
          <div>
            <dt><span aria-hidden="true">0{index + 1}</span><a href={`${base}${href}`}>{name}</a></dt>
            <dd>{compactNumber(value)}</dd>
          </div>
        ))}
      </dl>
      <p>These are source records, not a count of unique breaches. Different rules produce different kinds of evidence.</p>
    </aside>
  <aside class="publication-stamp shell" aria-label="Current publication">
    <div><span class="eyebrow">This edition</span><strong>Published {date(publication.generated_at)}</strong></div>
    <p>Publication checksum <code title={checksum}>{checksum.slice(0, 12)}</code></p>
    <p>Source revision <code title={sourceRevision}>{sourceRevision.slice(0, 12)}</code></p>
    <a href={`${base}source-health/`}>Review update status</a>
  </aside>
  <section class="section shell" aria-labelledby="latest">
    <div class="section-head">
      <div><span class="eyebrow">01 / The notices</span><h2 id="latest">Latest public notifications</h2></div>
      <a href={`${base}latest/`}>Search all published records <span aria-hidden="true">↗</span></a>
    </div>
    <p class="section-intro">The name on a notice may be the notifying organisation, not the affected organisation. Each record shows the role given by its source.</p>
    <NotificationTable records={notifications} limit={12} />
  </section>
  <section class="section shell" aria-labelledby="latest-update">
    <div class="section-head">
      <div><span class="eyebrow">02 / The changes</span><h2 id="latest-update">Since the last observation</h2></div>
      <p>{publication.update_digest.observed_at ? <>Observed {date(publication.update_digest.observed_at)}. </> : null}Source-record changes, not newly confirmed incidents.</p>
    </div>
    <div class="change-ledger">
      {changes.map(([name, value, description]) => (
        <article><strong class="metric">{compactNumber(value)}</strong><h3>{name}</h3><p>{description}</p></article>
      ))}
    </div>
    <p><a href={`${base}corrections/`}>Read the correction history</a></p>
  </section>
  <section class="section shell" aria-labelledby="four-views">
    <div class="section-head">
      <div><span class="eyebrow">03 / A reader’s guide</span><h2 id="four-views">Not every record is a breach notice.</h2></div>
      <p>The register keeps four kinds of information apart. None should be read as a measure of an organisation’s security.</p>
    </div>
    <div class="reading-guide">
      <article><span class="guide-number" aria-hidden="true">I.</span><h3>Named notifications</h3><p>Public notices name an organisation or agency. Its role, reporting threshold and source date matter.</p><a href={`${base}latest/`}>Read the notices</a></article>
      <article><span class="guide-number" aria-hidden="true">II.</span><h3>Anonymous reports</h3><p>French and UK reporting data appears as grouped counts. It is not used to identify organisations or link incidents.</p><a href={`${base}jurisdictions/`}>Browse the country views</a></article>
      <article><span class="guide-number" aria-hidden="true">III.</span><h3>Published statistics</h3><p>Regulators report totals for particular periods and populations. These figures do not become named incident records.</p><a href={`${base}source-coverage/`}>Compare the measures</a></article>
      <article><span class="guide-number" aria-hidden="true">IV.</span><h3>Regulator actions</h3><p>An investigation is not a finding. Allegations, undertakings, orders and decisions retain their stated legal status.</p><a href={`${base}australia/regulatory-actions/`}>Follow OAIC actions</a></article>
    </div>
  </section>
</BaseLayout>
