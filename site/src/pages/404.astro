---
import Hero from "../components/Hero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found"
  description="The requested Breach Gazette page was not found."
  section="Not found"
  robots="noindex,follow"
>
  <Hero
    eyebrow="404"
    title="That record page is not available."
    intro="The address may be incomplete, or the source record may not have a generated detail page."
    warning="A missing page does not mean that an official notification was deleted, resolved, or found to be inaccurate."
  />
  <section class="section shell">
    <p hidden data-legacy-record><a data-legacy-record-link>Look up this record in the current publication</a></p>
    <div class="grid">
      <article class="card">
        <h2><a href={`${import.meta.env.BASE_URL}latest/`}>Search notifications</a></h2>
        <p>Filter the complete bounded published notification dataset locally.</p>
      </article>
      <article class="card">
        <h2><a href={`${import.meta.env.BASE_URL}sources/`}>Review source coverage</a></h2>
        <p>Check official-source boundaries, thresholds, roles, and limitations.</p>
      </article>
    </div>
  </section>
  <script>
    const match = /^\/notifications\/([^/]+)\/?$/.exec(window.location.pathname);
    if (match) {
      try {
        const record = decodeURIComponent(match[1]!);
        if (record.length <= 300) {
          const parameters = new URLSearchParams({ query: record, record });
          const link = document.querySelector<HTMLAnchorElement>("[data-legacy-record-link]")!;
          link.href = `${import.meta.env.BASE_URL}latest/#${parameters}`;
          document.querySelector<HTMLElement>("[data-legacy-record]")!.hidden = false;
        }
      } catch { /* Invalid encoding retains the ordinary not-found page. */ }
    }
  </script>
</BaseLayout>
