---
import Hero from "../../components/Hero.astro";
import RegulatoryTimeline from "../../components/RegulatoryTimeline.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublication } from "../../lib/data";
const publication = getPublication();
const records = publication.regulatory_actions.filter((record) => record.source_id === "oaic_regulatory");
---
<BaseLayout title="OAIC regulatory actions" description="Status-aware OAIC regulatory action timeline." section="Australia / Regulation">
  <Hero eyebrow="Investigations & decisions" title="OAIC regulatory actions"
    intro="Each matter event retains the distinction between a preliminary inquiry, investigation, enforceable undertaking, proceeding, judgment and penalty order."
    warning="An allegation is not a finding. A closed preliminary inquiry without an adverse finding is not an endorsement or compliance assurance." />
  <nav class="shell record-links" aria-label="Related records">
    <a href={`${import.meta.env.BASE_URL}regulatory-actions/`}>All regulatory actions</a>
    <a href={`${import.meta.env.BASE_URL}australia/`}>Australian aggregate metrics</a>
  </nav>
  <RegulatoryTimeline records={records} policies={publication.policies} name="OAIC regulatory timeline" />
</BaseLayout>
