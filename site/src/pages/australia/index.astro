---
import Hero from "../../components/Hero.astro";
import SourceNote from "../../components/SourceNote.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublication } from "../../lib/data";
import { label } from "../../lib/format";

const publication = getPublication();
const records = publication.aggregates.filter((record) => record.source_id === "oaic_ndb");
const policy = publication.policies.oaic_ndb!;
const dimensions = [...new Set(records.map((record) => record.dimension))];
---

<BaseLayout title="Australia" description="OAIC national NDB aggregate statistics and explicit reporting semantics." section="Australia">
  <Hero
    eyebrow="National aggregate reporting"
    title="Australia’s NDB reporting patterns"
    intro="The OAIC received these notifications under the Notifiable Data Breaches scheme. Values are aggregate reporting measures, not named incidents."
  />
  <nav class="shell record-links" aria-label="Australian records">
    <a href={`${import.meta.env.BASE_URL}australia/regulatory-actions/`}>Regulatory actions</a>
    <a href={`${import.meta.env.BASE_URL}australia/nsw/`}>NSW aggregate metrics</a>
    <a href={`${import.meta.env.BASE_URL}australia/public-notifications/`}>NSW public notifications</a>
    <a href={`${import.meta.env.BASE_URL}aggregates/oaic_ndb/`}>Browse all national metrics by page</a>
  </nav>
  <section class="section shell">
    <div class="section-head"><h2>National measures by dimension</h2><p>{records.length} source cells across {dimensions.length} reviewed dimensions.</p></div>
    <p>This index counts published metric cells, not breaches. <a href={`${import.meta.env.BASE_URL}aggregates/oaic_ndb/`}>Read every national metric, with its reporting period and population.</a></p>
    <div class="table-wrap" tabindex="0" aria-label="OAIC aggregate metrics table">
      <table aria-label="OAIC aggregate metrics by dimension">
        <thead><tr><th scope="col">Dimension</th><th scope="col">Published metric cells</th></tr></thead>
        <tbody>
          {dimensions.sort().map((dimension) => (
            <tr>
              <th scope="row" data-label="Dimension">{label(dimension)}</th>
              <td data-label="Published metric cells">{records.filter((record) => record.dimension === dimension).length.toLocaleString("en-AU")}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
  <section class="section shell" aria-labelledby="interpretation">
    <div class="section-head"><h2 id="interpretation">How to read this view</h2></div>
    <div class="grid">
      <article class="card"><h3>Source of breach</h3><p>Source categories reflect OAIC-published classifications. Rounded values retain an estimated state.</p></article>
      <article class="card"><h3>Affected population</h3><p>Worldwide and Australian scopes remain distinct. Neither is silently substituted for the other.</p></article>
      <article class="card"><h3>Timing</h3><p>Identification and notification timing retain the source’s dimension and reporting period.</p></article>
      <article class="card"><h3>Revisions</h3><p>Source revisions are recorded over time. A historical value may change without creating a named incident.</p></article>
    </div>
    <SourceNote href={policy.source_url} />
  </section>
</BaseLayout>
