---
import { date, label } from "../lib/format";
import type { Notification } from "../lib/types";

interface Props {
  records: Notification[];
  limit?: number;
  showSummary?: boolean;
}
const { records, limit = 50, showSummary = true } = Astro.props;
const visible = records.slice(0, limit);
function observation(record: Notification): string | null {
  return record.dates.find((item) => item.normalized_date)?.normalized_date ?? null;
}
function viewerHref(record: Notification): string {
  const recordId = encodeURIComponent(record.source_record_id);
  return `${import.meta.env.BASE_URL}latest/#query=${recordId}&record=${recordId}`;
}
---

<div class="table-wrap" tabindex="0" aria-label="Public notification table">
  <table class="notification-table">
    <thead>
      <tr>
        <th scope="col">Named entity</th>
        <th scope="col">Source role</th>
        <th scope="col">Jurisdiction</th>
        <th scope="col">Source date</th>
        <th scope="col">Publication level</th>
      </tr>
    </thead>
    <tbody>
      {visible.map((record) => (
        <tr>
          <th class="notification-table__entity" scope="row" data-label="Named entity">
            {record.has_detail_page === false
              ? (
                <a href={viewerHref(record)}>
                  {record.named_entity.source_name}
                </a>
              )
              : (
                <a href={`${import.meta.env.BASE_URL}notifications/${record.source_record_id}/`}>
                  {record.named_entity.source_name}
                </a>
              )}
          </th>
          <td data-label="Source role">{label(record.named_entity.role)}</td>
          <td data-label="Jurisdiction">{record.jurisdiction}</td>
          <td data-label="Source date">{date(observation(record))}</td>
          <td data-label="Publication level">{label(record.publication_level)}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
{showSummary && records.length > limit && (
  <p class="table-note">Showing the first {limit} records on this static view.</p>
)}
