---
import { getNotificationPaginationItems } from "../lib/notifications";

interface Props {
  currentPage: number;
  pageCount: number;
  position: "top" | "bottom";
}

const { currentPage, pageCount, position } = Astro.props;
const base = import.meta.env.BASE_URL;
const pages = getNotificationPaginationItems(currentPage, pageCount);
const mobilePages = getNotificationPaginationItems(currentPage, pageCount, 1);
const pageHref = (page: number) => page === 1
  ? `${base}latest/#notification-results`
  : `${base}latest/pages/${page}/#notification-results`;
const label = position === "top"
  ? "Notification pages above results"
  : "Notification pages below results";
---

<div id={position === "top" ? "notification-results" : undefined}></div>
<nav
  class:list={["pagination", `pagination--${position}`]}
  aria-label={label}
  hidden={pageCount <= 1}
>
  {currentPage > 1
    ? (
      <a class="pagination__step" href={pageHref(currentPage - 1)} rel="prev">
        <span aria-hidden="true">←</span>
        <span class="pagination__step-label">Previous</span>
      </a>
    )
    : (
      <span class="pagination__step" aria-disabled="true">
        <span aria-hidden="true">←</span>
        <span class="pagination__step-label">Previous</span>
      </span>
    )}

  <span class="pagination__status">Page {currentPage} of {pageCount}</span>

  <ol class="pagination__pages pagination__pages--desktop">
    {pages.map((page) => page === null
      ? <li class="pagination__ellipsis" aria-hidden="true">…</li>
      : (
        <li class:list={{ "is-current": page === currentPage }}>
          {page === currentPage
            ? (
              <span aria-current="page">
                <span class="visually-hidden">Page </span>{page}
              </span>
            )
            : (
              <a href={pageHref(page)} aria-label={`Go to notification page ${page}`}>
                {page}
              </a>
            )}
        </li>
      ))}
  </ol>

  <ol class="pagination__pages pagination__pages--mobile">
    {mobilePages.map((page) => page === null
      ? <li class="pagination__ellipsis" aria-hidden="true">…</li>
      : (
        <li class:list={{ "is-current": page === currentPage }}>
          {page === currentPage
            ? (
              <span aria-current="page">
                <span class="visually-hidden">Page </span>{page}
              </span>
            )
            : (
              <a href={pageHref(page)} aria-label={`Go to notification page ${page}`}>
                {page}
              </a>
            )}
        </li>
      ))}
  </ol>

  {currentPage < pageCount
    ? (
      <a class="pagination__step" href={pageHref(currentPage + 1)} rel="next">
        <span class="pagination__step-label">Next</span>
        <span aria-hidden="true">→</span>
      </a>
    )
    : (
      <span class="pagination__step" aria-disabled="true">
        <span class="pagination__step-label">Next</span>
        <span aria-hidden="true">→</span>
      </span>
    )}
  {pageCount > 1 && (
    <div class="pagination__jump-slot" data-static-page-jump data-current-page={currentPage} data-page-count={pageCount} data-base={base}></div>
  )}
</nav>

<script>
  import { enhanceStaticPageJumps, submitPageJump } from "../lib/pageJump";
  enhanceStaticPageJumps();
  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element) || !event.target.closest("[data-page-jump] button")) return;
    const wrapper = event.target.closest<HTMLElement>("[data-page-jump]");
    if (wrapper) submitPageJump(wrapper);
  });
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Enter" || !(event.target instanceof HTMLInputElement)) return;
    const wrapper = event.target.closest<HTMLElement>("[data-page-jump]");
    if (wrapper) { event.preventDefault(); submitPageJump(wrapper); }
  });
  document.addEventListener("notification-page-jump", (event) => {
    if (!(event instanceof CustomEvent) || !(event.target instanceof Element)) return;
    const slot = event.target.closest<HTMLElement>("[data-static-page-jump]");
    if (!slot || !Number.isSafeInteger(event.detail)) return;
    const page = event.detail as number;
    if (page < 1 || page > Number(slot.dataset.pageCount)) return;
    const base = slot.dataset.base ?? "/";
    window.location.assign(page === 1 ? `${base}latest/#notification-results` : `${base}latest/pages/${page}/#notification-results`);
  });
</script>
