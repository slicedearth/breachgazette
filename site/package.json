{
  "name": "breachgazette-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "^24.14.0 || >=26.0.0",
    "npm": ">=11.0.0 <12.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:budget": "node scripts/build-with-budget.mjs",
    "build:test": "BREACHGAZETTE_TEST_BUILD=1 BREACHGAZETTE_SITE_DATA_DIR=../tests/fixtures/site astro build",
    "check": "astro check",
    "check:test": "BREACHGAZETTE_TEST_BUILD=1 BREACHGAZETTE_SITE_DATA_DIR=../tests/fixtures/site astro check",
    "preview": "astro preview",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:ci": "playwright test"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/sitemap": "3.7.3",
    "@playwright/test": "1.61.1",
    "@types/estree": "1.0.9",
    "astro": "7.1.3",
    "typescript": "6.0.3"
  }
}
